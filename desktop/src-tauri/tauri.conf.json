{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFile",
  "mainBinaryName": "openfile",
  "version": "1.1.0",
  "identifier": "com.aniruddhaadak.openfile",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenFile",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Aniruddha Adak",
    "copyright": "Copyright (c) Aniruddha Adak. MIT licensed.",
    "license": "MIT",
    "homepage": "https://aniruddhaadak80.github.io/OpenFile/",
    "category": "Productivity",
    "shortDescription": "Private file tools that run on your device",
    "longDescription": "OpenFile: 300+ free tools for PDF, images, video, audio, data and developers. Everything runs on your device, works offline and nothing is uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "section": "utils" }
    }
  }
}
