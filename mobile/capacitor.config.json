{
  "appId": "com.aniruddhaadak.openfile",
  "appName": "OpenFile",
  "webDir": "../dist",
  "backgroundColor": "#000000",
  "loggingBehavior": "debug",
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "minWebViewVersion": 94
  },
  "ios": {
    "backgroundColor": "#000000",
    "contentInset": "always",
    "scheme": "OpenFile"
  },
  "server": {
    "androidScheme": "https",
    "errorPath": "webview-update.html",
    "allowNavigation": [
      "aniruddhaadak80.github.io"
    ]
  }
}
