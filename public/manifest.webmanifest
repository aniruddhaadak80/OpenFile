{
  "name": "OpenFile: Private File Tools",
  "short_name": "OpenFile",
  "description": "Free tools for PDF, images, video, audio and developers that run on your device. Works offline. Open or share files straight into OpenFile.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "./",
  "categories": [
    "productivity",
    "utilities",
    "photo",
    "developer"
  ],
  "lang": "en",
  "dir": "ltr",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/json",
            "application/zip",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/epub+zip",
            "model/gltf-binary",
            "model/stl",
            "font/ttf",
            "font/otf",
            "font/woff",
            "font/woff2"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./open",
      "name": "PDF document",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./open",
      "name": "Image",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/svg+xml": [
          ".svg"
        ]
      }
    },
    {
      "action": "./open",
      "name": "Video",
      "accept": {
        "video/mp4": [
          ".mp4"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/x-matroska": [
          ".mkv"
        ]
      }
    },
    {
      "action": "./open",
      "name": "Audio",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/ogg": [
          ".ogg"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/mp4": [
          ".m4a"
        ]
      }
    },
    {
      "action": "./open",
      "name": "Document or data",
      "accept": {
        "application/zip": [
          ".zip"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ],
        "text/markdown": [
          ".md"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/epub+zip": [
          ".epub"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "All tools",
      "short_name": "Tools",
      "url": "./tools?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Merge PDF",
      "url": "./merge-pdf?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Compress PDF",
      "url": "./compress-pdf?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Compress images",
      "url": "./image-compressor?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Remove background",
      "url": "./background-remover?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Workspace",
      "url": "./workspace?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "screenshots": [
    {
      "src": "screenshots/wide-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Every file tool in one private tab"
    },
    {
      "src": "screenshots/wide-2.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Works offline and keeps files on your device"
    },
    {
      "src": "screenshots/narrow-1.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Every file tool on your phone"
    },
    {
      "src": "screenshots/narrow-2.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Works offline and stays private"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 420
  },
  "handle_links": "preferred"
}